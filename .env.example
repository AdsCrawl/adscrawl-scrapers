ADSCRAWL_API_KEY=your_api_key
ADSCRAWL_CONCURRENCY=2
# Browser route when a request does not set countryCode. Live runs default to US.
ADSCRAWL_DEFAULT_COUNTRY=US
# ChatGPT-only route. Leave unset to keep countryCode US. Other scrapers ignore it.
# ADSCRAWL_CHATGPT_COUNTRY=GB
# ADSCRAWL_BASE_URL=https://api.adscrawl.net
